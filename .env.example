# SubSearch — Developer Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before building.
# Values here are inlined into the bundle at build time by esbuild --define.
# They are NOT secret at runtime — anyone with the installed extension can read
# the compiled JS. Treat OAUTH_CLIENT_ID as public; it is safe to share.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google OAuth ──────────────────────────────────────────────────────────────
# "Chrome App" type client. Used by chrome.identity.getAuthToken() for the
# default account and for silent token refreshes.
OAUTH_CLIENT_ID=

# "Web application" type client, same Cloud project. Used by
# chrome.identity.launchWebAuthFlow() for "Add account", which is the only way
# to force Google's account chooser (prompt=select_account). getAuthToken()
# cannot do this — it always resolves to Chrome's own profile identity.
# Requires an Authorized redirect URI of https://<extension-id>.chromiumapp.org/
OAUTH_WEB_CLIENT_ID=

# ── Indexing ─────────────────────────────────────────────────────────────────
# Videos fetched per channel during a full index (clamped 5–50 in settings UI)
DEFAULT_VIDEOS_PER_CHANNEL=15

# ── API Quota ─────────────────────────────────────────────────────────────────
# Daily quota limit for your Google Cloud project (default: 10,000)
DAILY_QUOTA_LIMIT=10000

# Warn user when this fraction of daily quota is consumed (0.0–1.0)
QUOTA_WARN_THRESHOLD=0.80

# Abort indexing when this fraction of daily quota is consumed (0.0–1.0)
QUOTA_ABORT_THRESHOLD=0.95

# ── Background Sync ───────────────────────────────────────────────────────────
# How often the background alarm checks for new videos (minutes). Default: 480 = 8 hours
SYNC_INTERVAL_MINUTES=480

# ── Concurrent API Fetches ────────────────────────────────────────────────────
# Max parallel channel fetches during indexing. Keep at 3 to avoid 429 errors.
CONCURRENT_FETCHES=3

# ── Search ────────────────────────────────────────────────────────────────────
# Number of search results shown per query
DEFAULT_SEARCH_TOP_K=10

# Freshness score weight in final ranking (0.0 = ignore recency, 1.0 = recency only)
FRESHNESS_WEIGHT=0.3

# ── Monetization (leave blank to disable) ────────────────────────────────────
KOFI_USERNAME=
GUMROAD_URL=
SPONSOR_TEXT=
SPONSOR_URL=
